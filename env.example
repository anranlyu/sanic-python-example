# For local development with MySQL running in Docker (db service in docker-compose.yml),
# connect from your host/venv using the published port 3320.
MYSQL_HOST=localhost
MYSQL_PORT=3320
MYSQL_USER=app
MYSQL_PASSWORD=app_password
MYSQL_DATABASE=test_db

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24